{
  "name": "@reneturcios/sportstax",
  "version": "0.1.0",
  "description": "A local stdio bridge to the hosted Jock Taxes MCP service: professional-athlete tax calculations for NHL, NFL, MLB and NBA seasons, team moves and equivalent salaries, plus team player salary tables and the calculators' accepted inputs. One bin serves a small CLI and the MCP server.",
  "mcpName": "io.github.CloudCorpRecords/sportstax",
  "type": "module",
  "bin": {
    "sportstax": "dist/cli.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCorpRecords/sportstax.git"
  },
  "homepage": "https://github.com/CloudCorpRecords/sportstax#readme",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  }
}
